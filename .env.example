# ============================================================================
# HIROKI PANEL - ENVIRONMENT VARIABLES (.env.example)
# Sao chép file này thành .env.local (local) hoặc cài đặt trong Vercel Settings
# TUYỆT ĐỐI KHÔNG ĐƯA CÁC KHÓA BÍ MẬT VÀO BIẾN BẮT ĐẦU BẰNG NEXT_PUBLIC_
# ============================================================================

# 1. Supabase (Chỉ truy cập qua Server API bằng Service Role Key)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Bảo mật Phiên Admin & Cookie (Sinh ngẫu nhiên tối thiểu 32 bytes: openssl rand -hex 32)
ADMIN_USERNAME="hiroki_admin"
ADMIN_PASSWORD_HASH="" # Hoặc đặt ADMIN_PASSWORD để kiểm tra, khuyến nghị dùng scrypt/sha256 hash
ADMIN_PASSWORD="change_me_strong_password_123!"
ADMIN_TOTP_SECRET=""   # Tùy chọn: Base32 secret nếu bật 2FA cho Admin
ADMIN_SESSION_SECRET="replace-with-64-char-hex-random-secret-key-for-jose-jwt-signing"

# 3. Cặp khóa Chữ ký số Ed25519 cho /api/v1/verify & /api/v1/heartbeat
# Chạy lệnh: node scripts/generate-ed25519-keys.mjs để sinh cặp khóa k1 (chính) & k2 (dự phòng)
ED25519_ACTIVE_KID="k1"
ED25519_PRIVATE_KEY_K1="" # PKCS8 PEM encoded base64 (1 dòng)
ED25519_PUBLIC_KEY_K1=""  # SPKI PEM encoded base64 (1 dòng)
ED25519_PRIVATE_KEY_K2="" # Khóa dự phòng khi cần xoay vòng khóa (Key Rotation)
ED25519_PUBLIC_KEY_K2=""

# 4. Cloudflare Turnstile (Chống Bot khi Get Key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAACGAQppv0cG0heOE"
TURNSTILE_SECRET_KEY=""

# 5. Chế độ Nhận Key & Link Rút Gọn
# QUAN TRỌNG: Ở Production phải đặt ALLOW_DIRECT_CLAIM="false" (Mặc định Fail-Closed)
# Chỉ đặt "true" khi đang test ở môi trường dev chưa gắn API rút gọn link
ALLOW_DIRECT_CLAIM="false"
SHORTENER_CALLBACK_SECRET="replace-with-random-webhook-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

